from airflow import DAG
from airflow.operators.bash import BashOperator
from datetime import datetime

# -----------------------------
# Airflow DAG to clone a GitHub repository
# -----------------------------

default_args = {
    "owner": "airflow",
    "depends_on_past": False,
    "retries": 1,
}

with DAG(
    dag_id="clone_github_repo",
    default_args=default_args,
    description="Clone a Git repository using Airflow",
    schedule="@daily",   # Runs daily
    start_date=datetime(2025, 1, 1),
    catchup=False,
    tags=["git", "github"],
) as dag:

    clone_repo = BashOperator(
        task_id="clone_repo",
        bash_command="""
        REPO_URL="https://github.com/apache/airflow.git"
        TARGET_DIR="/tmp/airflow_repo"

        echo "Cleaning old repo if exists..."
        rm -rf $TARGET_DIR

        echo "Cloning repository..."
        git clone $REPO_URL $TARGET_DIR

        echo "Repository cloned successfully"
        """,
    )

    list_files = BashOperator(
        task_id="list_repo_files",
        bash_command="""